	)
	(text "Genera 1 WAIT STATE. Il clock su U86 cattura D3 durante la\ntransizione da basso a alto e copia il segnale sulla relativa\nuscita.\n"
		(exclude_from_sim no)
		(at 109.728 182.118 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "de5dbd03-8c51-4a29-a058-0b1e1104e7e9")
	)
	(text "Il segnale ~{XMEMR} è normalmente a livello logico 1 ( alto ).\nIl segnale è invertito dall'INVERTER U71. Al NAND U72 è presente\nun livello logico 0 ( alto )."
		(exclude_from_sim no)
		(at 22.606 125.984 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "de7a43c8-fee9-4074-8e31-60c6c6c9257a")
	)
	(text "0010 0000 - 0x20\n0100 0000 - 0x40\n0110 0000 - 0x60\n1000 0000 - 0x80\n1010 0000 - 0xA0\n1100 0000 - 0xC0\n1110 0000 - 0xE0"
		(exclude_from_sim no)
		(at 405.638 274.828 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "deb5fc4c-0a2a-4889-bca1-41caea8a1f32")
	)
	(text "Abilita CHIP ROM / RAM.\nUtilizza gli INDIRIZZI per realizzare la SEGMENTAZIONE ROM / RAM"
		(exclude_from_sim no)
		(at 473.456 172.466 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e067279d-391a-41f5-b3f7-d21e752f3cde")
	)
	(text "Il segnale HQR DMA BASSO provoca il CLEAR di U70.\nIl segnale HOLDA viene portato a livello logico ALTO."
		(exclude_from_sim no)
		(at 112.776 162.306 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e0f53cdf-79a8-48c6-aa6a-182c2c37f4a4")
	)
	(text "Se ~{LOCK} = 1 Il bus è libero e può essere utilizzato\nSe ~{LOCK} = 0 Il bus è in uso dalla CPU e risulta BLOCCATO\n\nI segnali S0, S1 sono entrambe a livello logico ALTO se\nla CPU è in modalità HALT e PASSIVO\n\nIl segnale S2 é 0 quando è in corso una lettura/scrittura\nsul BUS.\n\nIl segnale HRQDMA ( HRQ ) é il segnale di richiesta di\nHOLD dal DMA alla CPU ( richiesta bus ).\nNormalmente a livello logico 1 ( ALTO )\n\nNella logica AND tutti gli ingressi a 1 producono un out = 1,\ninvertito = 0 ( NAND )"
		(exclude_from_sim no)
		(at 24.13 174.498 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e186a5bc-4864-4905-bb86-89a932953c41")
	)
	(text "Per la legge di OHM 5V/4700Ohm = 0,001A ( 1mA )\n4,7KOhm = 4700Ohm"
		(exclude_from_sim no)
		(at 514.35 72.898 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f8353e41-c4af-492e-a018-3f5b4d477f5b")
	)
