	(text "~{RDY}/WAIT a 82C84A Clock Gen. ~{AEN1}\n~{DMA WAIT} a 82C84A Clock Gen. RDY1\nUsati per generale il segnale READY verso CPU"
		(exclude_from_sim no)
		(at 243.332 82.55 0)
		(effects
			(font
