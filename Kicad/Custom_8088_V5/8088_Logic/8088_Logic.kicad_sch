			)
		)
		(uuid "903504a4-d77c-44ee-a841-9eb6de9d920d")
	)
	(text "~{XIOR} e ~{XIOW} sono normalmente a livello logico 1 ( alto ).\nUn'operazione di lettura del I/O viene segnalata con il\ncambio di stato del segnale ~{XIOR} a livello logico 0 ( basso ).\nUn'operazione di scrittura del I/O viene segnalata con il\ncambio di stato del segnale ~{XIOW} a livello logico 0 ( basso )."
		(exclude_from_sim no)
		(at 48.26 50.546 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "932baffc-4821-4d83-abaf-ffe153256d2c")
	)
	(text "Stato dei bits 5,6,7 "
		(exclude_from_sim no)
		(at 406.4 262.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "967ae8ec-1956-4096-a136-a30feccaa16a")
	)
	(text "A9, A8\n01 0000 0000	= 0x100\n10 0000 0000	= 0x200\n11 0000 0000	= 0x300\n\n0x300 - 0x100 = 0x200 ( 512 bytes )"
		(exclude_from_sim no)
		(at 45.466 393.446 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a2ebae5c-173a-4235-b16b-ec209e4e645f")
	)
